# Maintainer: Gabin Roy <gabinroy@users.noreply.github.com>
pkgname=musializer-rs-bin
_pkgname=musializer-rs
pkgver=1.0.0
pkgrel=1
pkgdesc="High-Performance GPU-Accelerated Audio Visualizer in Rust"
arch=('x86_64')
url="https://github.com/gabinroy/musializer-rs"
license=('GPL-3.0-or-later')
depends=(
    'alsa-lib'
    'libx11'
    'libxcursor'
    'libxi'
    'libxrandr'
    'libxinerama'
    'wayland'
    'libxkbcommon'
    'vulkan-icd-loader'
)
optdepends=(
    'ffmpeg: for offline MP4 video export'
)
provides=('musializer-rs')
conflicts=('musializer-rs')
source_x86_64=("https://github.com/gabinroy/musializer-rs/releases/download/v${pkgver}/musializer-rs-x86_64-unknown-linux-gnu.tar.gz"
                "https://raw.githubusercontent.com/gabinroy/musializer-rs/v${pkgver}/assets/icon.png"
                "https://raw.githubusercontent.com/gabinroy/musializer-rs/v${pkgver}/distribution/org.musializer.MusializerRS.desktop"
                "https://raw.githubusercontent.com/gabinroy/musializer-rs/v${pkgver}/distribution/org.musializer.MusializerRS.metainfo.xml")
sha256sums_x86_64=('SKIP'
                    'SKIP'
                    'SKIP'
                    'SKIP')

package() {
    # Install main binary
    install -Dm755 "${srcdir}/musializer-rs" "${pkgdir}/usr/bin/musializer-rs"

    # Install desktop icon and entry
    install -Dm644 "${srcdir}/icon.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/org.musializer.MusializerRS.png"
    install -Dm644 "${srcdir}/icon.png" "${pkgdir}/usr/share/pixmaps/musializer-rs.png"
    install -Dm644 "${srcdir}/org.musializer.MusializerRS.desktop" "${pkgdir}/usr/share/applications/org.musializer.MusializerRS.desktop"
    install -Dm644 "${srcdir}/org.musializer.MusializerRS.metainfo.xml" "${pkgdir}/usr/share/metainfo/org.musializer.MusializerRS.metainfo.xml"
}
